if $prismjs_line_number
  @require 'line-number'

if $highlight_theme != false
  @require 'diff'

.container
  pre[class*='language-']
    @extend $scrollbar-style

    &:not(.line-numbers)
      padding: 10px 20px

    .caption
      margin-left: -3.8em
      padding: 4px 16px !important

      a
        padding: 0 !important
