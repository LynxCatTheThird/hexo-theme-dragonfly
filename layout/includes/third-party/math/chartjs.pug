- const { fontColor, borderColor, scale_ticks_backdropColor } = theme.chartjs

script(data-swup-reload-script).
  (() => {
    const pageSignal = dragonfly.pageSignal
    const applyThemeDefaultsConfig = theme => {
      if (theme === 'dark-mode') {
        Chart.defaults.color = "!{fontColor.dark}"
        Chart.defaults.borderColor = "!{borderColor.dark}"
        Chart.defaults.scale.ticks.backdropColor = "!{scale_ticks_backdropColor.dark}"
      } else {
        Chart.defaults.color = "!{fontColor.light}"
        Chart.defaults.borderColor = "!{borderColor.light}"
        Chart.defaults.scale.ticks.backdropColor = "!{scale_ticks_backdropColor.light}"
      }
    }

    // 递归应用当前配色模式的图表参数。
    const applyThemeConfig = (obj, theme) => {
      if (typeof obj !== 'object' || obj === null) return

      Object.keys(obj).forEach(key => {
        const value = obj[key]
        // 选择对象中与当前配色模式匹配的值。
        if (typeof value === 'object' && value !== null) {
          if (theme in value) {
            obj[key] = value[theme] // 应用当前配色的值。
          } else {
            // 递归处理子对象。
            applyThemeConfig(value, theme)
          }
        }
      })
    }

    const destroyChart = canvas => {
      const chart = canvas && window.Chart && Chart.getChart(canvas)
      if (chart) chart.destroy()
    }

    const runChartJS = ele => {
      Array.from(ele).forEach((item, index) => {
        if (pageSignal.aborted || !item.isConnected) return
        const theme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark-mode' : 'light-mode'
        const chartSrc = item.firstElementChild
        const chartID = item.getAttribute('data-chartjs-id') || ('chartjs-' + index) // 优先使用指定的图表 ID。
        const width = item.getAttribute('data-width')
        const existingCanvas = document.getElementById(chartID)

        const existingChart = existingCanvas && Chart.getChart(existingCanvas)
        if (existingChart && item.__chartTheme === theme && item.__chartDefinition === chartSrc.textContent) {
          existingChart.resize()
          return
        }

        // 重新挂载前释放已有图表与画布。
        if (existingCanvas) {
          destroyChart(existingCanvas)
          existingCanvas.parentNode.remove()
        }

        const chartDefinition = chartSrc.textContent
        const canvas = document.createElement('canvas')
        canvas.id = chartID

        const div = document.createElement('div')
        div.className = 'chartjs-wrap'

        if (width) {
          div.style.width = width
        }

        div.appendChild(canvas)
        chartSrc.insertAdjacentElement('afterend', div)

        const ctx = document.getElementById(chartID).getContext('2d')

        const config = JSON.parse(chartDefinition)
        config.options = { ...!{JSON.stringify(theme.chartjs.options || {}).replace(/</g, '\\u003c')}, ...config.options }


        // 初始化默认配色。
        applyThemeDefaultsConfig(theme)

        // 应用浅色或深色配色。
        applyThemeConfig(config, theme)

        new Chart(ctx, config)
        item.__chartTheme = theme
        item.__chartDefinition = chartDefinition
      })
    }

    const loadChartJS = () => {
      if (pageSignal.aborted) return
      const chartJSEle = document.querySelectorAll('#article-container .chartjs-container')
      if (chartJSEle.length === 0) return

      typeof window.Chart === 'function' ? runChartJS(chartJSEle) : dragonfly.getScript('!{url_for(theme.asset.chartjs)}').then(() => runChartJS(chartJSEle))
    }

    // 离页时释放图表实例。
    dragonfly.addGlobalFn('pageCleanup', () => {
      document.querySelectorAll('.chartjs-wrap canvas').forEach(destroyChart)
    }, 'chartjs')

    // 响应配色模式变化。
    dragonfly.addPageFn('themeChange', loadChartJS, 'chartjs')
    dragonfly.addPageFn('encrypt', loadChartJS, 'chartjs')

    document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', loadChartJS, { once: true }) : loadChartJS()
  })()
