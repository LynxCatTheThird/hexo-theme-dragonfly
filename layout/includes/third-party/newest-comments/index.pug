- let { use } = theme.comments

if use
  -
    let { limit:newestCommentsLimit } = theme.aside.card_newest_comments
    if (newestCommentsLimit > 10 || newestCommentsLimit < 1) newestCommentsLimit = 6

  case use[0]
    when 'Waline'
      include ./waline.pug
    when 'Twikoo'
      include ./twikoo-comment.pug
    when 'Artalk'
      include ./artalk.pug
